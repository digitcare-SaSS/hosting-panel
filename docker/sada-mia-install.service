[Unit]
Description=Sada Mia Panel first-boot installer
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=oneshot
Environment=HOME=/root COMPOSER_ALLOW_SUPERUSER=1
RemainAfterExit=yes
ExecStart=/usr/local/bin/sada-mia-firstboot
TimeoutStartSec=0
StandardOutput=journal+console
StandardError=journal+console

[Install]
WantedBy=multi-user.target
